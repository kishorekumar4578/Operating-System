int main()
{
    int req[20], n;
    int head, diskSize, direction;
    int choice;
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("\n1. FCFS");
    printf("\n2. SSTF");
    printf("\n3. SCAN");
    printf("\n4. C-SCAN");
    printf("\n5. LOOK");
    printf("\n6. C-LOOK");

    printf("\n\nEnter your choice: ");
    scanf("%d", &choice);

    if (choice >= 3 && choice <= 6)
    {
        printf("Enter direction (1 = Right, 0 = Left): ");
        scanf("%d", &direction);
    }

    switch (choice)
    {
        case 1:
            fcfs(req, n, head);
            break;

        case 2:
            sstf(req, n, head);
            break;

        case 3:
            scan(req, n, head, diskSize, direction);
            break;

        case 4:
            cscan(req, n, head, diskSize, direction);
            break;

        case 5:
            look(req, n, head, direction);
            break;

        case 6:
            clook(req, n, head, direction);
            break;

        default:
            printf("Invalid choice\n");
    }

    return 0;
}
